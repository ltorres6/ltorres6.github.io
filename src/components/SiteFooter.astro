---
import { site } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p>
      © {year}
      {site.name} · {site.location}
    </p>
    <p class="email">{site.email}</p>
    <nav aria-label="Elsewhere">
      <a href={site.links.github}>GitHub</a>
      <a href={site.links.gitlab}>GitLab</a>
      <a href={site.links.scholar}>Google Scholar</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--band);
    color: var(--band-muted);
    border-top: 1px solid var(--band-rule);
  }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 2rem;
    padding-block: 2rem;
    font-size: 0.875rem;
  }

  .email {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-left: auto;
  }

  a {
    color: var(--band-ink);
  }

  @media (max-width: 640px) {
    nav {
      margin-left: 0;
    }
  }
</style>
