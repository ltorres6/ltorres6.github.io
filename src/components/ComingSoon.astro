---
// Temporary placeholder for pages that move over in Phase 2 of the overhaul.
interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

<header class="page-title">
  <h1>{title}</h1>
  <p>{intro}</p>
</header>
<p class="note label">Moving to the new site · coming soon</p>

<style>
  .note {
    color: var(--gold-ink);
  }
</style>
